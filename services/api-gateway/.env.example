# API Gateway Environment Configuration
PORT=3000
NODE_ENV=development

# Microservices Target URLs
AUTH_SERVICE_URL=http://localhost:3003
CHAT_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
MEDIA_SERVICE_URL=http://localhost:3005

# JWT Secret for Edge Verification
JWT_ACCESS_SECRET=your-jwt-access-secret-key-32chars

# CORS Configuration
CORS_ORIGIN=*

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
