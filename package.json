{
  "name": "chat-portal-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "dev:gateway": "npm run start:dev --workspace=api-gateway",
    "dev:api-gateway": "npm run start:dev --workspace=api-gateway",
    "start:gateway": "npm run start:prod --workspace=api-gateway",
    "start:api-gateway": "npm run start:prod --workspace=api-gateway",
    "build:gateway": "npm run build --workspace=api-gateway",
    "build:api-gateway": "npm run build --workspace=api-gateway",
    "dev:chat": "npm run start:dev --workspace=chat-service",
    "dev:chat-service": "npm run start:dev --workspace=chat-service",
    "start:chat": "npm run start:prod --workspace=chat-service",
    "start:chat-service": "npm run start:prod --workspace=chat-service",
    "build:chat": "npm run build --workspace=chat-service",
    "build:chat-service": "npm run build --workspace=chat-service",
    "dev:user": "npm run start:dev --workspace=user-service",
    "dev:user-service": "npm run start:dev --workspace=user-service",
    "start:user": "npm run start:prod --workspace=user-service",
    "start:user-service": "npm run start:prod --workspace=user-service",
    "build:user": "npm run build --workspace=user-service",
    "build:user-service": "npm run build --workspace=user-service",
    "dev:all": "concurrently -c \"cyan,magenta,yellow,blue\" -n \"api-gateway,chat-service,user-service\" \"npm run dev:gateway\" \"npm run dev:chat\" \"npm run dev:user\"",
    "start:all": "npm run start:prod --workspaces --if-present",
    "build:all": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}