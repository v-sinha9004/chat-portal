{
  "name": "chat-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:gateway": "npm run start:dev --prefix services/api-gateway",
    "dev:api-gateway": "npm run start:dev --prefix services/api-gateway",
    "start:gateway": "npm run start:prod --prefix services/api-gateway",
    "start:api-gateway": "npm run start:prod --prefix services/api-gateway",
    "build:gateway": "npm run build --prefix services/api-gateway",
    "build:api-gateway": "npm run build --prefix services/api-gateway",
    "dev:chat": "npm run start:dev --prefix services/chat-service",
    "dev:chat-service": "npm run start:dev --prefix services/chat-service",
    "start:chat": "npm run start:prod --prefix services/chat-service",
    "start:chat-service": "npm run start:prod --prefix services/chat-service",
    "build:chat": "npm run build --prefix services/chat-service",
    "build:chat-service": "npm run build --prefix services/chat-service",
    "dev:user": "npm run start:dev --prefix services/user-service",
    "dev:user-service": "npm run start:dev --prefix services/user-service",
    "start:user": "npm run start:prod --prefix services/user-service",
    "start:user-service": "npm run start:prod --prefix services/user-service",
    "build:user": "npm run build --prefix services/user-service",
    "build:user-service": "npm run build --prefix services/user-service",
    "dev:auth": "npm run start:dev --prefix services/auth-service",
    "dev:auth-service": "npm run start:dev --prefix services/auth-service",
    "start:auth": "npm run start:prod --prefix services/auth-service",
    "start:auth-service": "npm run start:prod --prefix services/auth-service",
    "build:auth": "npm run build --prefix services/auth-service",
    "build:auth-service": "npm run build --prefix services/auth-service",
    "dev:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "prisma:generate:auth": "npm run prisma:generate --prefix services/auth-service",
    "prisma:generate:user": "npm run prisma:generate --prefix services/user-service",
    "prisma:generate:all": "npm run prisma:generate:auth && npm run prisma:generate:user",
    "install:all": "npm install --prefix services/api-gateway && npm install --prefix services/auth-service && npm install --prefix services/chat-service && npm install --prefix services/user-service && npm install --prefix client",
    "build:all": "npm run build:gateway && npm run build:auth && npm run build:user && npm run build:chat",
    "dev:all": "concurrently -c \"cyan,magenta,yellow,blue,green\" -n \"api-gateway,chat-service,user-service,auth-service\" \"npm run dev:gateway\" \"npm run dev:chat\" \"npm run dev:user\" \"npm run dev:auth\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}